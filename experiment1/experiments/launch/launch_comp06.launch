<launch>
	<include file="$(find kinect)/launch/launch_all.launch"> </include>

	<include file="$(find screen)/launch/screen.launch"> </include>

	<include file="$(find virtual-agent)/launch/launch_phase2.launch"> </include>

	<!-- Parameter to indicate if the last data should be recovered (1) or not (0). -->
	<arg name="recover" default="0"/>
	<param name="~recover" type="int" value="$(arg recover)" />

	<node pkg="experiments" type="main.py" name="experiments" output="screen"/>

	<!-- (1) if it should record camera, (0) if not. -->
	<arg name="record" value="1" />

	<!-- Configuring and running record node. -->
	<!-- YOU SHOULD UPDATE THE PARAMETERS BELOW IF RECORD IS ACTIVATED. -->
	<group if="$(arg record)">

		<!-- Name of the image topic to be recorded -->
		<param name="~image_topic" type="string" value="/camera4/rgb4/image_color" />

		<!-- Number associated with the camera. -->
		<arg name="~camera_number" value="4" />

		<!-- Parameter to indicate if the video should be created (1) or not (0) -->
		<param name="~video" type="int" value="0" />

		<!-- Name of the folder with the frames and the text file, if they already exist. -->
		<arg name="files" default=""/>
		<param name="~files_param" type="string" value="$(arg files)" />

		<param name="~camera_number" value="$(arg ~camera_number)" />
		<node pkg="experiments" type="record.py" name="record_kinect$(arg ~camera_number)" output="screen"/>

	</group>

</launch>
